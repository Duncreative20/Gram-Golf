{
  "expo": {
    "name": "GramGolf",
    "slug": "gramgolf",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "gramgolf",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#0B2230"
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
